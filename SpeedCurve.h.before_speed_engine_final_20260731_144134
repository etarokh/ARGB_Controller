#pragma once

#include <Arduino.h>

enum class SpeedProfile : uint8_t
{
  AnimatedHue,
  Continuous,
  Sequential,
  Breathing
};

class SpeedCurve
{
public:

  // New standardized API
  static uint32_t interval(
    uint8_t speedPercent,
    SpeedProfile profile
  )
  {
    switch (profile)
    {
      case SpeedProfile::AnimatedHue:
        return interval(
          speedPercent,
          350,
          2
        );

      case SpeedProfile::Continuous:
        return interval(
          speedPercent,
          500,
          3
        );

      case SpeedProfile::Sequential:
        return interval(
          speedPercent,
          700,
          5
        );

      case SpeedProfile::Breathing:
        return interval(
          speedPercent,
          1800,
          70
        );
    }

    return interval(
      speedPercent,
      650,
      8
    );
  }

  // Legacy API (keep for compatibility)
  static uint32_t interval(
    uint8_t speedPercent,
    uint32_t slowestIntervalMs,
    uint32_t fastestIntervalMs
  )
  {
    speedPercent = constrain(
      speedPercent,
      1,
      100
    );

    if (
      slowestIntervalMs <
      fastestIntervalMs
    )
    {
      const uint32_t temp =
        slowestIntervalMs;

      slowestIntervalMs =
        fastestIntervalMs;

      fastestIntervalMs =
        temp;
    }

    const float t =
      (speedPercent - 1) /
      99.0f;

    // Gamma curve (~2.5)
    const float curved =
      t * t * sqrtf(t);

    return
      slowestIntervalMs -
      (
        slowestIntervalMs -
        fastestIntervalMs
      ) * curved;
  }
};
