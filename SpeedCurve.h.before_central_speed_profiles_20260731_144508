#pragma once

#include <Arduino.h>

enum class SpeedProfile : uint8_t
{
  AnimatedHue,
  Continuous,
  Sequential,
  Breathing
};

class SpeedCurve
{
public:

  static uint32_t interval(
    uint8_t speedPercent,
    SpeedProfile profile
  )
  {
    switch (profile)
    {
      case SpeedProfile::AnimatedHue:
        return interval(
          speedPercent,
          1200,
          1
        );

      case SpeedProfile::Continuous:
        return interval(
          speedPercent,
          1800,
          2
        );

      case SpeedProfile::Sequential:
        return interval(
          speedPercent,
          3000,
          4
        );

      case SpeedProfile::Breathing:
        return interval(
          speedPercent,
          5000,
          25
        );
    }

    return interval(
      speedPercent,
      1500,
      2
    );
  }

  static uint32_t interval(
    uint8_t speedPercent,
    uint32_t slowestIntervalMs,
    uint32_t fastestIntervalMs
  )
  {
    speedPercent = constrain(
      speedPercent,
      1,
      100
    );

    if (
      slowestIntervalMs <
      fastestIntervalMs
    )
    {
      const uint32_t temp =
        slowestIntervalMs;

      slowestIntervalMs =
        fastestIntervalMs;

      fastestIntervalMs =
        temp;
    }

    const float x =
      (speedPercent - 1) /
      99.0f;

    const float curved =
      x * x *
      (
        3.0f -
        2.0f * x
      );

    const float intervalMs =
      slowestIntervalMs -
      (
        slowestIntervalMs -
        fastestIntervalMs
      ) * curved;

    return static_cast<uint32_t>(
      intervalMs + 0.5f
    );
  }
};
