#include "RingAnimationEngine.h"

void RingAnimationEngine::begin()
{
  reset();
}

void RingAnimationEngine::reset()
{
  progress = 0;
}

void RingAnimationEngine::setColor(
  const CRGB& value
)
{
  color = value;
}

void RingAnimationEngine::setProgress(
  uint8_t value
)
{
  progress = constrain(
    value,
    0,
    LEDS_PER_RING
  );
}

void RingAnimationEngine::setPattern(
  uint8_t value
)
{
  pattern = value;
}

void RingAnimationEngine::renderRingGroup(
  CRGB* leds,
  uint16_t ledCount
) const
{
  if (leds == nullptr)
  {
    return;
  }

  for (
    uint16_t index = 0;
    index < ledCount;
    index++
  )
  {
    const uint8_t ledPosition =
      index % LEDS_PER_RING;

    const uint8_t fillOrder =
      getFillOrder(
        ledPosition
      );

    if (fillOrder < progress)
    {
      leds[index] = color;
    }
    else
    {
      leds[index] = CRGB::Black;
    }
  }
}

uint8_t RingAnimationEngine::getFillOrder(
  uint8_t ledPosition
) const
{
  static const uint8_t CENTER_OUT_ORDER[
    LEDS_PER_RING
  ] =
  {
    6, 4, 2, 0, 1, 3, 5, 7
  };

  static const uint8_t OUTSIDE_IN_ORDER[
    LEDS_PER_RING
  ] =
  {
    0, 2, 4, 6, 7, 5, 3, 1
  };

  switch (pattern)
  {
    case 0:
      return ledPosition;

    case 1:
      return
        LEDS_PER_RING -
        1 -
        ledPosition;

    case 2:
      return CENTER_OUT_ORDER[
        ledPosition
      ];

    case 3:
      return OUTSIDE_IN_ORDER[
        ledPosition
      ];

    default:
      return ledPosition;
  }
}
