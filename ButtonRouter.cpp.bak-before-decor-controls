#include "ButtonRouter.h"

void ButtonRouter::begin(
  ButtonManager* buttonManager,
  BuzzerManager* buzzerManager,
  LedManager* ledManager,
  EffectManager* effectManager,
  DecorativeEffectManager* decorativeManager,
  SettingsManager* settingsMenuManager,
  BrightnessManager* brightnessControlManager,
  MonitorManager* monitorModeManager,
  ModeManager* systemModeManager
)
{
  button = buttonManager;
  buzzer = buzzerManager;
  leds = ledManager;
  effects = effectManager;
  decorative = decorativeManager;
  settings = settingsMenuManager;
  brightness = brightnessControlManager;
  monitorManager = monitorModeManager;
  modeManager = systemModeManager;
}

void ButtonRouter::update()
{
  if (
    button == nullptr ||
    modeManager == nullptr
  )
  {
    return;
  }

  button->update();

  const bool threshold24HourReached =
    button->was24HourThresholdReached();

  const bool threshold30DayReached =
    button->was30DayThresholdReached();

  const bool threshold6MonthReached =
    button->was6MonthThresholdReached();

  const bool snooze24HoursPress =
    button->wasSnooze24HoursPressed();

  const bool snooze30DaysPress =
    button->wasSnooze30DaysPressed();

  const bool snooze6MonthsPress =
    button->wasSnooze6MonthsPressed();

  const bool longPress =
    button->wasLongPressed();

  const bool doublePress =
    button->wasDoublePressed();

  const bool triplePress =
    button->wasTriplePressed();

  const bool quadruplePress =
    button->wasQuadruplePressed();

  const bool singlePress =
    button->wasPressed();

  if (isAlertContextActive())
  {
    handleAlertContext(
      singlePress,
      doublePress,
      triplePress,
      quadruplePress,
      longPress,
      snooze24HoursPress,
      snooze30DaysPress,
      snooze6MonthsPress,
      threshold24HourReached,
      threshold30DayReached,
      threshold6MonthReached
    );

    return;
  }

  switch (modeManager->getMode())
  {
    case SystemMode::Decorative:
      handleDecorativeContext(
        singlePress,
        doublePress,
        triplePress,
        quadruplePress,
        longPress,
        snooze24HoursPress,
        snooze30DaysPress,
        snooze6MonthsPress
      );
      break;

    case SystemMode::Settings:
      handleSettingsContext(
        singlePress,
        doublePress,
        triplePress,
        quadruplePress,
        longPress,
        snooze24HoursPress,
        snooze30DaysPress,
        snooze6MonthsPress
      );
      break;

    case SystemMode::Monitor:
      handleMonitorContext(
        singlePress,
        doublePress,
        triplePress,
        quadruplePress,
        longPress,
        snooze24HoursPress,
        snooze30DaysPress,
        snooze6MonthsPress
      );
      break;

    case SystemMode::Off:
      handleOffContext(
        singlePress,
        doublePress,
        triplePress,
        quadruplePress,
        longPress,
        snooze24HoursPress,
        snooze30DaysPress,
        snooze6MonthsPress
      );
      break;
  }
}

bool ButtonRouter::isAlertContextActive() const
{
  if (
    effects == nullptr ||
    modeManager == nullptr
  )
  {
    return false;
  }

  const uint8_t activeMask =
    effects->getActiveAlertMask();

  const uint8_t snoozedMask =
    modeManager->getSnoozedAlertMask();

  const uint8_t unsnoozedMask =
    activeMask &
    static_cast<uint8_t>(~snoozedMask);

  return unsnoozedMask != 0;
}

void ButtonRouter::handleAlertContext(
  bool singlePress,
  bool doublePress,
  bool triplePress,
  bool quadruplePress,
  bool longPress,
  bool snooze24HoursPress,
  bool snooze30DaysPress,
  bool snooze6MonthsPress,
  bool threshold24HourReached,
  bool threshold30DayReached,
  bool threshold6MonthReached
)
{
  if (
    buzzer == nullptr ||
    effects == nullptr ||
    modeManager == nullptr
  )
  {
    return;
  }

  if (threshold24HourReached)
  {
    buzzer->beep(70);

    Serial.println(
      "BUTTON ALERT: 24-HOUR THRESHOLD"
    );
  }

  if (threshold30DayReached)
  {
    buzzer->beep(70);
    delay(90);
    buzzer->beep(70);

    Serial.println(
      "BUTTON ALERT: 30-DAY THRESHOLD"
    );
  }

  if (threshold6MonthReached)
  {
    buzzer->beep(70);
    delay(90);
    buzzer->beep(70);
    delay(90);
    buzzer->beep(70);

    Serial.println(
      "BUTTON ALERT: 6-MONTH THRESHOLD"
    );
  }

  if (snooze6MonthsPress)
  {
    buzzer->mute(
      effects->getCriticalAlertMask()
    );

    modeManager->snoozeAlertsFor6Months();

    playSnoozeAnimation(
      3,
      10,
      CRGB::Red
    );

    return;
  }

  if (snooze30DaysPress)
  {
    buzzer->mute(
      effects->getCriticalAlertMask()
    );

    modeManager->snoozeAlertsFor30Days();

    playSnoozeAnimation(
      2,
      6,
      CRGB::Green
    );

    return;
  }

  if (snooze24HoursPress)
  {
    buzzer->mute(
      effects->getCriticalAlertMask()
    );

    modeManager->snoozeAlertsFor24Hours();

    playSnoozeAnimation(
      1,
      3,
      CRGB::Green
    );

    return;
  }

  if (quadruplePress)
  {
    buzzer->beep(100);
    delay(100);
    buzzer->beep(250);

    Serial.println(
      "BUTTON ALERT: FOUR"
    );

    Serial.println(
      "CLEAR_ACTIVE"
    );

    return;
  }

  if (singlePress)
  {
    if (effects->hasCriticalAlert())
    {
      buzzer->mute(
        effects->getCriticalAlertMask()
      );

      Serial.println(
        "BUZZER: Current Critical alerts muted"
      );
    }
    else
    {
      Serial.println(
        "BUTTON ALERT: SINGLE — NO ACTIVE BUZZER"
      );
    }
  }

  if (doublePress)
  {
    logReserved(
      "ALERT",
      "DOUBLE"
    );
  }

  if (triplePress)
  {
    logReserved(
      "ALERT",
      "TRIPLE"
    );
  }

  if (longPress)
  {
    logReserved(
      "ALERT",
      "LONG 1-3 SEC"
    );
  }
}

void ButtonRouter::handleDecorativeContext(
  bool singlePress,
  bool doublePress,
  bool triplePress,
  bool quadruplePress,
  bool longPress,
  bool snooze24HoursPress,
  bool snooze30DaysPress,
  bool snooze6MonthsPress
)
{
  if (
    singlePress &&
    decorative != nullptr
  )
  {
    decorative->nextEffect();
    printDecorativeStatus();
  }

  if (doublePress)
  {
    logReserved(
      "DECORATIVE",
      "DOUBLE — SPEED CONTROL"
    );
  }

  if (triplePress)
  {
    logReserved(
      "DECORATIVE",
      "TRIPLE"
    );
  }

  if (quadruplePress)
  {
    logReserved(
      "DECORATIVE",
      "FOUR"
    );
  }

  if (longPress)
  {
    logReserved(
      "DECORATIVE",
      "LONG — BRIGHTNESS CONTROL"
    );
  }

  if (snooze24HoursPress)
  {
    logReserved(
      "DECORATIVE",
      "HOLD 3-6 SEC"
    );
  }

  if (snooze30DaysPress)
  {
    logReserved(
      "DECORATIVE",
      "HOLD 6-10 SEC"
    );
  }

  if (snooze6MonthsPress)
  {
    logReserved(
      "DECORATIVE",
      "HOLD 10+ SEC"
    );
  }
}


void ButtonRouter::handleSettingsContext(
  bool singlePress,
  bool doublePress,
  bool triplePress,
  bool quadruplePress,
  bool longPress,
  bool snooze24HoursPress,
  bool snooze30DaysPress,
  bool snooze6MonthsPress
)
{
  if (
    singlePress &&
    settings != nullptr
  )
  {
    settings->nextItem();
  }

  const bool brightnessSelected =
    settings != nullptr &&
    settings->getSelectedItem() ==
      SettingsItem::Brightness;

  const bool brightnessHoldActive =
    brightnessSelected &&
    button != nullptr &&
    button->isCurrentlyPressed() &&
    button->getCurrentHoldDuration() >=
      700UL;

  if (brightness != nullptr)
  {
    brightness->updateAdjustment(
      brightnessHoldActive
    );

    if (brightnessSelected)
    {
      brightness->showPreview();
    }
  }

  if (brightnessHoldActive)
  {
    settingsBrightnessAdjusted = true;
  }

  if (
    longPress &&
    settingsBrightnessAdjusted
  )
  {
    settingsBrightnessAdjusted = false;

    if (brightness != nullptr)
    {
      Serial.print(
        "Brightness selected: "
      );

      Serial.println(
        brightness->getBrightness()
      );
    }
  }
  else if (longPress)
  {
    logReserved(
      "SETTINGS",
      "LONG"
    );
  }

  if (doublePress)
  {
    logReserved(
      "SETTINGS",
      "DOUBLE"
    );
  }

  if (triplePress)
  {
    logReserved(
      "SETTINGS",
      "TRIPLE"
    );
  }

  if (quadruplePress)
  {
    logReserved(
      "SETTINGS",
      "FOUR"
    );
  }

  if (snooze24HoursPress)
  {
    settingsBrightnessAdjusted = false;
  }

  if (snooze30DaysPress)
  {
    settingsBrightnessAdjusted = false;
  }

  if (snooze6MonthsPress)
  {
    settingsBrightnessAdjusted = false;
  }
}

