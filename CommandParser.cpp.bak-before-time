#include "CommandParser.h"

#include <string.h>

void CommandParser::begin(
  EffectManager* effectManager
)
{
  effects = effectManager;
  inputLength = 0;
  bufferOverflow = false;
  inputBuffer[0] = '\0';

  Serial.println(
    "SERIAL_PARSER_READY"
  );
}

void CommandParser::update()
{
  while (Serial.available() > 0)
  {
    const char incoming =
      static_cast<char>(Serial.read());

    if (incoming == '\r')
    {
      continue;
    }

    if (incoming == '\n')
    {
      if (bufferOverflow)
      {
        printError(
          "COMMAND_TOO_LONG"
        );
      }
      else if (inputLength > 0)
      {
        inputBuffer[inputLength] = '\0';
        processLine(inputBuffer);
      }

      inputLength = 0;
      bufferOverflow = false;
      inputBuffer[0] = '\0';

      continue;
    }

    if (bufferOverflow)
    {
      continue;
    }

    if (
      inputLength <
      BUFFER_SIZE - 1
    )
    {
      inputBuffer[inputLength] =
        incoming;

      inputLength++;
    }
    else
    {
      bufferOverflow = true;
    }
  }
}

void CommandParser::processLine(
  char* line
)
{
  if (effects == nullptr)
  {
    printError(
      "PARSER_NOT_INITIALIZED"
    );
    return;
  }

  MonitorState cpuState;
  MonitorState networkState;

  MonitorState diskStates[
    EffectManager::DISK_COUNT
  ];

  bool cpuFound = false;
  bool networkFound = false;

  bool diskFound[
    EffectManager::DISK_COUNT
  ] = {
    false,
    false,
    false,
    false
  };

  char* savePointer = nullptr;

  char* token = strtok_r(
    line,
    ";",
    &savePointer
  );

  while (token != nullptr)
  {
    char* separator =
      strchr(token, '=');

    if (separator == nullptr)
    {
      printError(
        "INVALID_TOKEN"
      );
      return;
    }

    *separator = '\0';

    const char* key = token;
    const char* value =
      separator + 1;

    MonitorState parsedState;

    if (
      !parseState(
        value,
        parsedState
      )
    )
    {
      printError(
        "INVALID_STATE"
      );
      return;
    }

    if (
      strcmp(key, "CPU") == 0
    )
    {
      if (cpuFound)
      {
        printError(
          "DUPLICATE_CPU"
        );
        return;
      }

      cpuState = parsedState;
      cpuFound = true;
    }
    else if (
      strcmp(key, "NET") == 0
    )
    {
      if (networkFound)
      {
        printError(
          "DUPLICATE_NET"
        );
        return;
      }

      networkState = parsedState;
      networkFound = true;
    }
    else if (
      strcmp(key, "B1") == 0 ||
      strcmp(key, "B2") == 0 ||
      strcmp(key, "B3") == 0 ||
      strcmp(key, "B4") == 0
    )
    {
      const uint8_t diskIndex =
        static_cast<uint8_t>(
          key[1] - '1'
        );

      if (diskFound[diskIndex])
      {
        printError(
          "DUPLICATE_BAY"
        );
        return;
      }

      diskStates[diskIndex] =
        parsedState;

      diskFound[diskIndex] =
        true;
    }
    else
    {
      printError(
        "UNKNOWN_KEY"
      );
      return;
    }

    token = strtok_r(
      nullptr,
      ";",
      &savePointer
    );
  }

  if (
    !cpuFound ||
    !networkFound
  )
  {
    printError(
      "INCOMPLETE_SNAPSHOT"
    );
    return;
  }

  for (
    uint8_t i = 0;
    i < EffectManager::DISK_COUNT;
    i++
  )
  {
    if (!diskFound[i])
    {
      printError(
        "INCOMPLETE_SNAPSHOT"
      );
      return;
    }
  }

  effects->setCpuState(
    cpuState
  );

  effects->setNetworkState(
    networkState
  );

  for (
    uint8_t i = 0;
    i < EffectManager::DISK_COUNT;
    i++
  )
  {
    effects->setDiskState(
      i,
      diskStates[i]
    );
  }

  Serial.println(
    "ACK"
  );
}

bool CommandParser::parseState(
  const char* value,
  MonitorState& state
) const
{
  if (
    value == nullptr ||
    value[0] == '\0' ||
    value[1] != '\0'
  )
  {
    return false;
  }

  switch (value[0])
  {
    case 'N':
      state =
        MonitorState::Normal;
      return true;

    case 'W':
      state =
        MonitorState::Warning;
      return true;

    case 'C':
      state =
        MonitorState::Critical;
      return true;

    case 'O':
      state =
        MonitorState::Offline;
      return true;

    default:
      return false;
  }
}

void CommandParser::printError(
  const char* message
) const
{
  Serial.print(
    "ERR:"
  );

  Serial.println(
    message
  );
}
