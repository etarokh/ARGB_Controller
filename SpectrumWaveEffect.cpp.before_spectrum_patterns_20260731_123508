#include "SpectrumWaveEffect.h"

void SpectrumWaveEffect::renderFrame()
{
  if (leds == nullptr)
  {
    return;
  }

  for (
    uint8_t groupIndex = 0;
    groupIndex < GROUP_COUNT;
    groupIndex++
  )
  {
    const uint16_t ledCount =
      getGroupLedCount(
        groupIndex
      );

    for (
      uint16_t ledIndex = 0;
      ledIndex < ledCount;
      ledIndex++
    )
    {
      const uint8_t hueOffset =
        static_cast<uint8_t>(
          (
            groupIndex * 64
          ) +
          (
            ledIndex * 12
          )
        );

      setGroupPixel(
        groupIndex,
        ledIndex,
        hsvColor(
          hueOffset,
          255,
          255
        )
      );
    }
  }

  // Brightness is controlled globally.
}
