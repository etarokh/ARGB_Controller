#pragma once

#include <Arduino.h>
#include <FastLED.h>

#include "LedManager.h"

enum class MonitorState : uint8_t {
  Normal,
  Warning,
  Critical,
  Offline
};


struct AlertState {
  MonitorState hardware = MonitorState::Normal;
  MonitorState software = MonitorState::Normal;
  MonitorState system = MonitorState::Normal;
};


enum class AlertType : uint8_t {
  Normal,

  HardwareWarning,
  HardwareCritical,
  HardwareOffline,

  SoftwareWarning,
  SoftwareCritical,

  SystemWarning,
  SystemCritical
};


class EffectManager {
public:

  static constexpr uint8_t DISK_COUNT = 4;


  void begin(LedManager* ledManager);

  void update();


  void setDefaultColor(const CRGB& color);


  void setNetworkState(MonitorState state);

  void setPoolSoftwareState(MonitorState state);

  void setCpuState(MonitorState state);
  void setCpuHardwareState(MonitorState state);
  void setCpuSoftwareState(MonitorState state);
  void setCpuSystemState(MonitorState state);

  void setDiskState(
    uint8_t diskIndex,
    MonitorState state
  );


  void setDiskHardwareState(
    uint8_t diskIndex,
    MonitorState state
  );

  void setDiskSoftwareState(
    uint8_t diskIndex,
    MonitorState state
  );

  void setDiskSystemState(
    uint8_t diskIndex,
    MonitorState state
  );

  MonitorState getDiskState(
    uint8_t diskIndex
  ) const;


  void setAllDisksState(
    MonitorState state
  );


  void setEnabled(bool enabled);

  bool isEnabled() const;


  bool hasActiveAlert() const;

  bool hasCriticalAlert() const;


  uint8_t getActiveAlertMask() const;

  uint8_t getCriticalAlertMask() const;


private:

  LedManager* leds = nullptr;


  CRGB defaultColor = CRGB::Blue;


  MonitorState networkState = MonitorState::Normal;

  MonitorState poolSoftwareState = MonitorState::Normal;


  // Legacy states - kept during migration
  MonitorState cpuState = MonitorState::Normal;

  MonitorState diskStates[DISK_COUNT];


  // New hardware/software alert model
  AlertState cpuAlert;

  AlertState diskAlerts[DISK_COUNT];


  bool enabled = true;

  bool needsRender = true;


  uint8_t alertQueue[DISK_COUNT];

  uint8_t alertCount = 0;

  uint8_t queuePosition = 0;

  bool queueNeedsRebuild = true;


  bool monitorLedOn = true;

  unsigned long lastMonitorBlinkChange = 0;


  int8_t activeDiskIndex = -1;

  bool hddLedOn = true;

  uint8_t completedBlinks = 0;

  unsigned long lastBlinkChange = 0;


  static constexpr unsigned long MONITOR_BLINK_ON_MS = 500;

  static constexpr unsigned long MONITOR_BLINK_OFF_MS = 500;


  static constexpr unsigned long BLINK_ON_MS = 300;

  static constexpr unsigned long BLINK_OFF_MS = 300;

  static constexpr unsigned long BETWEEN_DISKS_MS = 1500;


  CRGB colorForState(
    MonitorState state,
    const CRGB& normalColor
  ) const;


  uint8_t statePriority(
    MonitorState state
  ) const;


  void rebuildAlertQueue();

  void startCurrentQueueDisk();

  void moveToNextQueueDisk();

  void resetBlinkSequence();

  void updateMonitorBlink();

  void updateHddBlink();


  CRGB blinkingColorForState(
    MonitorState state
  ) const;


  void render();

};
