void ButtonRouter::playSnoozeAnimation(
  uint8_t beepCount,
  uint8_t flashCount,
  const CRGB& flashColor
)
{
  if (
    buzzer == nullptr ||
    leds == nullptr
  )
  {
    return;
  }

  for (uint8_t i = 0; i < beepCount; i++)
  {
    buzzer->beep(100);

    if (i + 1 < beepCount)
    {
      delay(120);
    }
  }

  for (uint8_t i = 0; i < flashCount; i++)
  {
    leds->setAll(flashColor);
    leds->show();
    delay(220);

    leds->clear();
    delay(180);
  }
}

void ButtonRouter::printDecorativeStatus()
{
  if (decorative == nullptr)
  {
    return;
  }

  Serial.println();
  Serial.println(
    "Decorative status:"
  );

  Serial.print(
    "Effect: "
  );

  Serial.println(
    decorative->getEffectName()
  );

  Serial.print(
    "Palette: "
  );

  Serial.println(
    decorative->getPaletteName()
  );

  Serial.print(
    "Speed: "
  );

  Serial.print(
    decorative->getSpeed()
  );

  Serial.println("%");
}

void ButtonRouter::logReserved(
  const char* context,
  const char* gesture
)
{
  Serial.print(
    "BUTTON "
  );

  Serial.print(context);

  Serial.print(
    ": "
  );

  Serial.print(gesture);

  Serial.println(
    " — RESERVED"
  );
}
