#include "ButtonRouter.h"

void ButtonRouter::begin(
  ButtonManager* buttonManager,
  BuzzerManager* buzzerManager,
  LedManager* ledManager,
  EffectManager* effectManager,
  DecorativeEffectManager* decorativeManager,
  SettingsManager* settingsMenuManager,
  BrightnessManager* brightnessControlManager,
  MonitorManager* monitorModeManager,
  ModeManager* systemModeManager
)
{
  button = buttonManager;
  buzzer = buzzerManager;
  leds = ledManager;
  effects = effectManager;
  decorative = decorativeManager;
  settings = settingsMenuManager;
  brightness = brightnessControlManager;
  monitorManager = monitorModeManager;
  modeManager = systemModeManager;
}

void ButtonRouter::update()
{
  if (
    button == nullptr ||
    modeManager == nullptr
  )
  {
    return;
  }

  button->update();

  const bool threshold24HourReached =
    button->was24HourThresholdReached();

  const bool threshold30DayReached =
    button->was30DayThresholdReached();

  const bool threshold6MonthReached =
    button->was6MonthThresholdReached();

  const bool snooze24HoursPress =
    button->wasSnooze24HoursPressed();

  const bool snooze30DaysPress =
    button->wasSnooze30DaysPressed();

  const bool snooze6MonthsPress =
    button->wasSnooze6MonthsPressed();

  const bool longPress =
    button->wasLongPressed();

  const bool doublePress =
    button->wasDoublePressed();

  const bool triplePress =
    button->wasTriplePressed();

  const bool quadruplePress =
    button->wasQuadruplePressed();

  const bool singlePress =
    button->wasPressed();

  if (isAlertContextActive())
  {
    handleAlertContext(
      singlePress,
      doublePress,
      triplePress,
      quadruplePress,
      longPress,
      snooze24HoursPress,
      snooze30DaysPress,
      snooze6MonthsPress,
      threshold24HourReached,
      threshold30DayReached,
      threshold6MonthReached
    );

    return;
  }

  switch (modeManager->getMode())
  {
    case SystemMode::Decorative:
      handleDecorativeContext(
        singlePress,
        doublePress,
        triplePress,
        quadruplePress,
        longPress,
        snooze24HoursPress,
        snooze30DaysPress,
        snooze6MonthsPress
      );
      break;

    case SystemMode::Settings:
      handleSettingsContext(
        singlePress,
        doublePress,
        triplePress,
        quadruplePress,
        longPress,
        snooze24HoursPress,
        snooze30DaysPress,
        snooze6MonthsPress
      );
      break;

    case SystemMode::Monitor:
      handleMonitorContext(
        singlePress,
        doublePress,
        triplePress,
        quadruplePress,
        longPress,
        snooze24HoursPress,
        snooze30DaysPress,
        snooze6MonthsPress
      );
      break;

    case SystemMode::Off:
      handleOffContext(
        singlePress,
        doublePress,
        triplePress,
        quadruplePress,
        longPress,
        snooze24HoursPress,
        snooze30DaysPress,
        snooze6MonthsPress
      );
      break;
  }
}

bool ButtonRouter::isAlertContextActive() const
{
  if (
    effects == nullptr ||
    modeManager == nullptr
  )
  {
    return false;
  }

  const uint8_t activeMask =
    effects->getActiveAlertMask();

  const uint8_t snoozedMask =
    modeManager->getSnoozedAlertMask();

  const uint8_t unsnoozedMask =
    activeMask &
    static_cast<uint8_t>(~snoozedMask);

  return unsnoozedMask != 0;
}

void ButtonRouter::handleAlertContext(
  bool singlePress,
  bool doublePress,
  bool triplePress,
  bool quadruplePress,
  bool longPress,
  bool snooze24HoursPress,
  bool snooze30DaysPress,
  bool snooze6MonthsPress,
  bool threshold24HourReached,
  bool threshold30DayReached,
  bool threshold6MonthReached
)
{
  if (
    buzzer == nullptr ||
    effects == nullptr ||
    modeManager == nullptr
  )
  {
    return;
  }

  if (threshold24HourReached)
  {
    buzzer->beep(70);

    Serial.println(
      "BUTTON ALERT: 24-HOUR THRESHOLD"
    );
  }

  if (threshold30DayReached)
  {
    buzzer->beep(70);
    delay(90);
    buzzer->beep(70);

    Serial.println(
      "BUTTON ALERT: 30-DAY THRESHOLD"
    );
  }

  if (threshold6MonthReached)
  {
    buzzer->beep(70);
    delay(90);
    buzzer->beep(70);
    delay(90);
    buzzer->beep(70);

    Serial.println(
      "BUTTON ALERT: 6-MONTH THRESHOLD"
    );
  }

  if (snooze6MonthsPress)
  {
    buzzer->mute(
      effects->getCriticalAlertMask()
    );

    modeManager->snoozeAlertsFor6Months();

    playSnoozeAnimation(
      3,
      10,
      CRGB::Red
    );

    return;
  }

  if (snooze30DaysPress)
  {
    buzzer->mute(
      effects->getCriticalAlertMask()
    );

    modeManager->snoozeAlertsFor30Days();

    playSnoozeAnimation(
      2,
      6,
      CRGB::Green
    );

    return;
  }

  if (snooze24HoursPress)
  {
    buzzer->mute(
      effects->getCriticalAlertMask()
    );

    modeManager->snoozeAlertsFor24Hours();

    playSnoozeAnimation(
      1,
      3,
      CRGB::Green
    );

    return;
  }

  if (quadruplePress)
  {
    buzzer->beep(100);
    delay(100);
    buzzer->beep(250);

    Serial.println(
      "BUTTON ALERT: FOUR"
    );

    Serial.println(
      "CLEAR_ACTIVE"
    );

    return;
  }

  if (singlePress)
  {
    if (effects->hasCriticalAlert())
    {
      buzzer->mute(
        effects->getCriticalAlertMask()
      );

      Serial.println(
        "BUZZER: Current Critical alerts muted"
      );
    }
    else
    {
      Serial.println(
        "BUTTON ALERT: SINGLE — NO ACTIVE BUZZER"
      );
    }
  }

  if (doublePress)
  {
    logReserved(
      "ALERT",
      "DOUBLE"
    );
  }

  if (triplePress)
  {
    logReserved(
      "ALERT",
      "TRIPLE"
    );
  }

  if (longPress)
  {
    logReserved(
      "ALERT",
      "LONG 1-3 SEC"
    );
  }
}

void ButtonRouter::handleDecorativeContext(
  bool singlePress,
  bool doublePress,
  bool triplePress,
  bool quadruplePress,
  bool longPress,
  bool snooze24HoursPress,
  bool snooze30DaysPress,
  bool snooze6MonthsPress
)
{
  if (
    button == nullptr ||
    decorative == nullptr ||
    brightness == nullptr
  )
  {
    return;
  }

  const bool currentlyPressed =
    button->isCurrentlyPressed();

  const unsigned long holdDuration =
    button->getCurrentHoldDuration();

  const uint8_t pressNumber =
    button->getCurrentPressNumber();

  static unsigned long lastDebug = 0;

  if (millis() - lastDebug >= 200)
  {
    lastDebug = millis();

    Serial.print("P=");
    Serial.print(currentlyPressed);

    Serial.print(" H=");
    Serial.print(holdDuration);

    Serial.print(" N=");
    Serial.print(pressNumber);

    Serial.print(" A=");
    Serial.println(
      static_cast<int>(
        decorativeAdjustment
      )
    );
  }

  Serial.print("pressed=");
  Serial.print(currentlyPressed);
  Serial.print(" hold=");
  Serial.print(holdDuration);
  Serial.print(" press=");
  Serial.print(pressNumber);
  Serial.print(" adj=");
  Serial.println(
    static_cast<int>(
      decorativeAdjustment
    )
  );

  if (
    decorativeAdjustment ==
      DecorativeAdjustment::None &&
    currentlyPressed &&
    holdDuration >= 700UL
  )
  {
    if (pressNumber == 1)
    {
      decorativeAdjustment =
        DecorativeAdjustment::Brightness;

      button->suppressCurrentPressRelease();

      Serial.println(
        "Decorative brightness adjustment started"
      );
    }
    else if (pressNumber == 2)
    {
      decorativeAdjustment =
        DecorativeAdjustment::Speed;

      decorativeSpeedIncreasing =
        decorative->getSpeed() <= 1;

      lastDecorativeSpeedAdjustmentAt = 0;

      button->suppressCurrentPressRelease();

      Serial.println(
        "Decorative speed adjustment started"
      );
    }
  }

  const bool brightnessAdjusting =
    decorativeAdjustment ==
      DecorativeAdjustment::Brightness &&
    currentlyPressed;

  brightness->updateAdjustment(
    brightnessAdjusting
  );

  if (
    decorativeAdjustment ==
      DecorativeAdjustment::Speed &&
    currentlyPressed
  )
  {
    Serial.println(">>> SPEED LOOP <<<");
    const unsigned long now =
      millis();

    if (
      lastDecorativeSpeedAdjustmentAt == 0 ||
      now - lastDecorativeSpeedAdjustmentAt >=
        1200UL
    )
    {
      lastDecorativeSpeedAdjustmentAt = now;

      const uint8_t previousSpeed =
        decorative->getSpeed();

      uint8_t currentSpeed =
        previousSpeed;

      constexpr uint8_t MIN_SPEED = 1;
      constexpr uint8_t MAX_SPEED = 100;
      constexpr uint8_t SPEED_STEP = 20;

      if (decorativeSpeedIncreasing)
      {
        if (
          currentSpeed >=
            MAX_SPEED - SPEED_STEP
        )
        {
          currentSpeed = MAX_SPEED;
        }
        else
        {
          currentSpeed += SPEED_STEP;
        }
      }
      else
      {
        if (
          currentSpeed <=
            MIN_SPEED + SPEED_STEP
        )
        {
          currentSpeed = MIN_SPEED;
        }
        else
        {
          currentSpeed -= SPEED_STEP;
        }
      }

      decorative->setSpeed(
        currentSpeed
      );

      Serial.print(
        "Decorative speed preview: "
      );

      Serial.print(
        currentSpeed
      );

      Serial.println("%");

      const bool reachedMaximum =
        decorativeSpeedIncreasing &&
        previousSpeed < MAX_SPEED &&
        currentSpeed == MAX_SPEED;

      const bool reachedMinimum =
        !decorativeSpeedIncreasing &&
        previousSpeed > MIN_SPEED &&
        currentSpeed == MIN_SPEED;

      if (
        reachedMaximum ||
        reachedMinimum
      )
      {
        flashDecorativeSpeedBoundary();

        decorativeSpeedIncreasing =
          !decorativeSpeedIncreasing;
      }
    }
  }

  if (
    decorativeAdjustment !=
      DecorativeAdjustment::None &&
    !currentlyPressed
  )
  {
    if (
      decorativeAdjustment ==
        DecorativeAdjustment::Brightness
    )
    {
      Serial.print(
        "Decorative brightness selected: "
      );

      Serial.println(
        brightness->getBrightness()
      );
    }
    else
    {
      Serial.print(
        "Decorative speed selected: "
      );

      Serial.print(
        decorative->getSpeed()
      );

      Serial.println("%");
    }

    decorativeAdjustment =
      DecorativeAdjustment::None;

    lastDecorativeSpeedAdjustmentAt = 0;

    return;
  }

  if (
    singlePress &&
    decorativeAdjustment ==
      DecorativeAdjustment::None
  )
  {
    if (
      decorative->getEffect() ==
        DecorativeEffectType::StaticColor
    )
    {
      decorative->nextStaticColor();

      printDecorativeStatus();
    }
    else if (
      decorative->getEffect() ==
        DecorativeEffectType::RowLedSync ||
      decorative->getEffect() ==
        DecorativeEffectType::SpectrumWave ||
      decorative->getEffect() ==
        DecorativeEffectType::TwinkleStars ||
      decorative->getEffect() ==
        DecorativeEffectType::GradientFlow ||
      decorative->getEffect() ==
        DecorativeEffectType::LavaLamp ||
      decorative->getEffect() ==
        DecorativeEffectType::Plasma ||
      decorative->getEffect() ==
        DecorativeEffectType::Fire ||
      decorative->getEffect() ==
        DecorativeEffectType::Nebula ||
      decorative->getEffect() ==
        DecorativeEffectType::GroupFillWave ||
      decorative->getEffect() ==
        DecorativeEffectType::AlternatingStatic
    )
    {
      decorative->nextPattern();

      printDecorativeStatus();
    }
  }

  if (
    doublePress &&
    decorativeAdjustment ==
      DecorativeAdjustment::None
  )
  {
    decorative->nextEffect();

    printDecorativeStatus();
  }

  if (triplePress)
  {
    logReserved(
      "DECORATIVE",
      "TRIPLE"
    );
  }

  if (quadruplePress)
  {
    logReserved(
      "DECORATIVE",
      "FOUR"
    );
  }

  if (
    longPress ||
    snooze24HoursPress ||
    snooze30DaysPress ||
    snooze6MonthsPress
  )
  {
    // Decorative hold gestures are handled live.
  }
}


void ButtonRouter::
flashDecorativeSpeedBoundary()
{
  if (leds == nullptr)
  {
    return;
  }

  // Two blinks at minimum or maximum speed.
  for (uint8_t i = 0; i < 2; i++)
  {
    leds->setEffectBrightness(0);
    leds->show();
    delay(90);

    leds->setEffectBrightness(255);
    leds->show();
    delay(110);
  }
}

