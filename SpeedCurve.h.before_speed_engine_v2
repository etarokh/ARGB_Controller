#pragma once

#include <Arduino.h>

class SpeedCurve
{
public:
  static uint32_t interval(
    uint8_t speedPercent,
    uint32_t slowestIntervalMs,
    uint32_t fastestIntervalMs
  )
  {
    if (speedPercent < 1)
    {
      speedPercent = 1;
    }

    if (speedPercent > 100)
    {
      speedPercent = 100;
    }

    if (slowestIntervalMs < fastestIntervalMs)
    {
      const uint32_t temporary =
        slowestIntervalMs;

      slowestIntervalMs =
        fastestIntervalMs;

      fastestIntervalMs =
        temporary;
    }

    const uint32_t speedRange = 99;

    const uint32_t intervalRange =
      slowestIntervalMs -
      fastestIntervalMs;

    const uint32_t normalizedSpeed =
      speedPercent - 1;

    const uint32_t scaledSpeed =
      normalizedSpeed *
      normalizedSpeed;

    const uint32_t scaledRange =
      speedRange *
      speedRange;

    return slowestIntervalMs -
      (
        intervalRange *
        scaledSpeed /
        scaledRange
      );
  }
};
