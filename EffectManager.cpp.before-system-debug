#include "EffectManager.h"

void EffectManager::begin(LedManager* ledManager) {
  leds = ledManager;

  cpuAlert.hardware = MonitorState::Normal;
  cpuAlert.software = MonitorState::Normal;
  cpuAlert.system = MonitorState::Normal;
  for (uint8_t i = 0; i < DISK_COUNT; i++) {
     diskAlerts[i].hardware = MonitorState::Normal;
     diskAlerts[i].software = MonitorState::Normal;
     diskAlerts[i].system = MonitorState::Normal;  
  }

  resetBlinkSequence();

  needsRender = true;
  render();
}

void EffectManager::update() {
  if (queueNeedsRebuild) {
    rebuildAlertQueue();
  }

  updateMonitorBlink();
  updateHddBlink();

  if (needsRender) {
    render();
  }
}

void EffectManager::setDefaultColor(const CRGB& color) {
  defaultColor = color;
  needsRender = true;
}

