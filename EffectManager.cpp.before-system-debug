void EffectManager::setDiskState(
  uint8_t diskIndex,
  MonitorState state
) {
  if (diskIndex >= DISK_COUNT) {
    return;
  }

  if (diskStates[diskIndex] == state) {
    return;
  }

  diskStates[diskIndex] = state;

  queueNeedsRebuild = true;
  resetBlinkSequence();
  needsRender = true;
}


